# Supabase Configuration
# Obtén estos valores en supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Google Places API (Opcional para valoraciones en vivo de Google)
# Si no se configuran, la web mostrará el botón directo a Google Maps sin puntuaciones simuladas.
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=

